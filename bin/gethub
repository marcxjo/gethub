#!/bin/bash

#
# gethub - conveniently clone/update repos in a directory tree
#

# Linting ######################################################################

# Disable non-constant source because we source hooks by dir path -
# note that hooks are enabled at user discretion
# shellcheck disable=SC1090

# Disable checking cd fail
# We only cd to and from cloned repos, so if cd fails, we have bigger problems
# shellcheck disable=SC2164

# Variables ####################################################################

CONFIG_DIR=${GETHUB_CONFIG_DIR:-"${HOME}/.config/gethub"}

# TFM ##########################################################################

usage() {
  cat <<EOF

  ${0##*/} - A Convenient Git Repository Syncing Tool

  Usage:
    ${0##*/} [ CLONE_OPTIONS -- ] REPO_TREE

  Parameters:

  CLONE_OPTIONS
      The command-line options which would normally be passed to the `git clone`
	  command. These options are forwarded to `git clone` without alteration.

  REPO_TREE
      The space-separated collection of subpaths in the repo's URL (excluding the
      Git provider's base href). For a GitHub URL, this is usually a collection
      of 2 strings: the repo's username and the repo name itself. The \`.git\`
      prefix should be excluded from the final argument.

EOF
}

# Functions ####################################################################

join_array() {
  local -r _delimiter="$1"
  local -ra _arr=("${@:2}")

  (
    IFS="$_delimiter"
    echo "${_arr[*]}"
  )
}

build_path() {
  local -ar _segments=("$@")

  # HACK - overwriting a global variable with a local one
  # Any cleaner way I can find to do this is also unnecessarily verbose
  join_array '/' "${_segments[@]}"
}

get_index() {
  local -r _needle="$1"

  [[ -z "$_needle" ]] &&
    echo -1 &&
    return 1

  local -r _haystack=("${@:2}")

  [[ ${#_haystack[@]} -le 0 ]] &&
    echo -1 &&
    return 1

  for x in "${!_haystack[@]}"; do
    if [[ "${_haystack[$x]}" = "$_needle" ]]; then
      echo "$x"
      return
    fi
  done

  echo -1
  return 1
}

get_provider_property() {
  local -r _provider_id="$1"
  local -r _property_name="$2"

  git config -f ${CONFIG_DIR}/config --get "provider.${_provider_id}.${_property_name}"
}

build_repo_directory_path() {
  local -r _provider_id="$1"
  local -r _repo_subtree="$2"

  local -r _root_path="$(get_provider_property "${_provider_id}" 'rootPath')"
  local -r _repo_dir="${_root_path}/${_subtree}"

  echo "$_repo_dir"
}

build_repo_url() {
  local -r _provider_id="$1"
  local -r _repo_subtree="$2"

  local -r _root_url="$(get_provider_property "${_provider_id}" 'rootUrl')"
  local -r _repo_suffix="$(get_provider_property "${_provider_id}" 'gitSuffix')"
  local -r _repo_url="${_root_url}${_subtree}${_repo_suffix}"

  echo "$_repo_url"
}

################################################################################

main() {
  local -ri _opts_separator_index=$(get_index '--' "$@")
  local -ri _opts_offset=$((_opts_separator_index + 1))

  local -a _git_clone_opts

  if [[ $_opts_separator_index -gt 0 ]]; then
    _git_clone_opts=("${@:1:${_opts_offset}}")
  fi

  shift $_opts_offset

  [[ -r ${HOME}/.config/gethub/providers ]] &&
    . "${HOME}/.config/gethub/providers"

  local -r _provider="${GIT_PROVIDERS[$1]:-$1}"
  local -ra _path_segments=("${@:2}")

  local -r _subtree="$(build_path "${_path_segments[@]}")"

  local -r _repo_dir="$(build_repo_directory_path "$_provider" "$_subtree")"
  local -r _repo_url="$(build_repo_url "$_provider" "$_subtree")"

  if [[ -d ${_repo_dir} ]]; then
    echo "Updating repository at ${_repo_dir}..."
    GIT_DIR="${_repo_dir}/.git" git pull
  else
    git clone "${_git_clone_opts[@]}" "${_repo_url}" "${_repo_dir}"
  fi
}

main "$@"

exit 0
